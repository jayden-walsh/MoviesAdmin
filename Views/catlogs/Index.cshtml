@model IEnumerable<MoviesAdmin.Models.catlogs>
@{
    ViewData["Title"] = "Catalogs";
}

<h1>Catalogs</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Title)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Title)</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.catlogId">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.catlogId">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.catlogId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>