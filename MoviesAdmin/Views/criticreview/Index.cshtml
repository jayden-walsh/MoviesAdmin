@model IEnumerable<MoviesAdmin.Models.criticreview>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Raiting)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.madeby)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.madeData)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IsPublished)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Movie)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Description)
            </td>
            <td>
                @Html.DisplayFor(model => item.Raiting)
            </td>
            <td>
                @Html.DisplayFor(model => item.madeby)
            </td>
            <td>
                @Html.DisplayFor(model => item.madeData)
            </td>
            <td>
                @Html.DisplayFor(model => item.IsPublished)
            </td>
            <td>
                @Html.DisplayFor(model => item.Movie)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.ReivewsId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.ReivewsId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.ReivewsId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
